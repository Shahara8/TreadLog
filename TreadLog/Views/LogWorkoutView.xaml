<UserControl x:Class="TreadLog.Views.LogWorkoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource AppBackground}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,28" MaxWidth="620" HorizontalAlignment="Left">

            <!-- ── Header ──────────────────────────────────────────────────── -->
            <TextBlock FontSize="26" FontWeight="Bold" Margin="0,0,0,4">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Text" Value="Log Workout"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                <Setter Property="Text" Value="Edit Workout"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="Record a new treadmill session"
                       FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,0,0,28"/>

            <!-- ── Date + unit ──────────────────────────────────────────────── -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Date" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <DatePicker SelectedDate="{Binding SessionDate, Mode=TwoWay}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                    <TextBlock Text="Unit" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="km" GroupName="Unit"
                                     IsChecked="{Binding SelectedUnit,
                                         Converter={StaticResource StringEqualConverter},
                                         ConverterParameter=km}"/>
                        <RadioButton Content="mi" GroupName="Unit"
                                     IsChecked="{Binding SelectedUnit,
                                         Converter={StaticResource StringEqualConverter},
                                         ConverterParameter=mi}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ── Distance ─────────────────────────────────────────────────── -->
            <StackPanel Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding SelectedUnit, StringFormat='Distance ({0})'}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding DistanceInput, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="Calc" VerticalAlignment="Bottom"
                            Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding AutoCalcDistanceCommand}" ToolTip="Calculate from speed × duration"/>
                </Grid>
                <TextBlock Text="{Binding DistanceError}" Foreground="{StaticResource ErrorBrush}"
                           FontSize="11" Margin="0,4,0,0"
                           Visibility="{Binding DistanceError, Converter={StaticResource NotEmptyToVisibilityConverter}}"/>
            </StackPanel>

            <!-- ── Speed ────────────────────────────────────────────────────── -->
            <StackPanel Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding SelectedUnit, StringFormat='Avg Speed ({0}/h)'}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding SpeedInput, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="Calc" VerticalAlignment="Bottom"
                            Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding AutoCalcSpeedCommand}" ToolTip="Calculate from distance ÷ duration"/>
                </Grid>
                <TextBlock Text="{Binding SpeedError}" Foreground="{StaticResource ErrorBrush}"
                           FontSize="11" Margin="0,4,0,0"
                           Visibility="{Binding SpeedError, Converter={StaticResource NotEmptyToVisibilityConverter}}"/>
            </StackPanel>

            <!-- ── Duration ─────────────────────────────────────────────────── -->
            <StackPanel Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Hours" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding DurationHoursInput, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Minutes" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding DurationMinutesInput, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Seconds" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding DurationSecondsInput, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <Button Grid.Column="6" Content="Calc" VerticalAlignment="Bottom"
                            Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding AutoCalcDurationCommand}" ToolTip="Calculate from distance ÷ speed"/>
                </Grid>
                <TextBlock Text="{Binding DurationError}" Foreground="{StaticResource ErrorBrush}"
                           FontSize="11" Margin="0,4,0,0"
                           Visibility="{Binding DurationError, Converter={StaticResource NotEmptyToVisibilityConverter}}"/>
            </StackPanel>

            <!-- ── Incline ───────────────────────────────────────────────────── -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Incline (%)" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <TextBox Text="{Binding InclineInput, UpdateSourceTrigger=PropertyChanged}"
                         MaxWidth="200" HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding InclineError}" Foreground="{StaticResource ErrorBrush}"
                           FontSize="11" Margin="0,4,0,0"
                           Visibility="{Binding InclineError, Converter={StaticResource NotEmptyToVisibilityConverter}}"/>
            </StackPanel>

            <!-- ── Optional fields ───────────────────────────────────────────── -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Calories (optional)" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding CaloriesInput, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="{Binding CaloriesError}" Foreground="{StaticResource ErrorBrush}"
                               FontSize="11" Margin="0,4,0,0"
                               Visibility="{Binding CaloriesError, Converter={StaticResource NotEmptyToVisibilityConverter}}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Avg Heart Rate bpm (optional)" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding HeartRateInput, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="{Binding HeartRateError}" Foreground="{StaticResource ErrorBrush}"
                               FontSize="11" Margin="0,4,0,0"
                               Visibility="{Binding HeartRateError, Converter={StaticResource NotEmptyToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>

            <!-- ── Consistency warning ───────────────────────────────────────── -->
            <Border Margin="0,0,0,16" Padding="12,10" CornerRadius="6"
                    Background="#3D2800"
                    Visibility="{Binding ConsistencyWarning,
                        Converter={StaticResource NotEmptyToVisibilityConverter}}">
                <TextBlock Text="{Binding ConsistencyWarning}"
                           Foreground="{StaticResource WarningBrush}" FontSize="13"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- ── Action buttons ────────────────────────────────────────────── -->
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Save Workout" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding SaveCommand}" Margin="0,0,12,0"/>
                <Button Content="Clear" Style="{StaticResource GhostButtonStyle}"
                        Command="{Binding ClearFormCommand}"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
