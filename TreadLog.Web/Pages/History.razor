@page "/history"
@inject ApiClient Api
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="page-title">History</div>

<!-- Filter bar -->
<div class="filter-bar">
    <input class="form-control" placeholder="Search..." @bind="_search" @oninput="OnSearchInput" />
    <input type="date" class="form-control" @bind="_dateFrom" @bind:format="yyyy-MM-dd" />
    <input type="date" class="form-control" @bind="_dateTo" @bind:format="yyyy-MM-dd" />
    <button class="btn btn-ghost btn-sm" @onclick="LoadAsync">Apply</button>
    <button class="btn btn-ghost btn-sm" @onclick="ClearFilters">Clear</button>
</div>

<!-- Import/Export toolbar -->
<div class="section-header">
    <span class="section-title">@_filtered.Count sessions</span>
    <div class="gap-row">
        <button class="btn btn-ghost btn-sm" @onclick="ExportCsv">Export CSV</button>
        <button class="btn btn-ghost btn-sm" @onclick="ExportJson">Export JSON</button>
        <InputFile id="importInput" OnChange="ImportFile" style="display:none" accept=".csv,.json" />
        <button class="btn btn-ghost btn-sm" @onclick='() => JS.InvokeVoidAsync("document.getElementById", "importInput").AsTask()'>Import</button>
    </div>
</div>

@if (_importStatus != null)
{
    <div class="alert @(_importStatus.StartsWith("Error") ? "alert-danger" : "alert-success") mb-1">
        @_importStatus
    </div>
}

@if (_loading)
{
    <div class="text-muted">Loading...</div>
}
else if (!_filtered.Any())
{
    <div class="text-muted mt-2">No sessions found.</div>
}
else
{
    <div class="session-list">
        @foreach (var s in _filtered)
        {
            <div class="session-card">
                <div class="session-card-top">
                    <span class="session-date">@s.SessionDate.ToLocalTime().ToString("ddd MMM d, yyyy")</span>
                    <span class="session-dist">@FormatDist(s.DistanceKm)</span>
                </div>
                <div class="session-meta">
                    @if (s.ProgramId.HasValue)
                    {
                        var pName = _programNames.GetValueOrDefault(s.ProgramId.Value, "Program");
                        <span class="session-meta-item">
                            <span class="prog-badge">@pName</span>
                            @if (s.Completed)
                            { <span class="badge-ok">&#x2713;</span> }
                            else
                            { <span class="badge-fail">&#x2715;</span> }
                        </span>
                    }
                    <span class="session-meta-item">&#x23F1; @FormatDuration(s.DurationSeconds)</span>
                    <span class="session-meta-item">&#x26A1; @FormatSpeed(s.AvgSpeedKmh)</span>
                    <span class="session-meta-item">&#x1F3C3; @UnitConverter.CalculatePaceString(s.DistanceKm, s.DurationSeconds, _unit)/@(_unit)</span>
                    <span class="session-meta-item">&#x1F4CF; @s.InclinePercent.ToString("F1")%</span>
                    @if (s.CaloriesBurned.HasValue)
                    { <span class="session-meta-item">&#x1F525; @s.CaloriesBurned kcal</span> }
                    @if (s.AvgHeartRate.HasValue)
                    { <span class="session-meta-item">&#x2764;&#xFE0F; @s.AvgHeartRate bpm</span> }
                </div>
                <div class="session-actions">
                    <button class="btn btn-ghost btn-sm" @onclick="() => Edit(s.Id)">Edit</button>
                    <button class="btn btn-danger btn-sm" @onclick="() => Delete(s.Id)">Delete</button>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<WorkoutSession> _all      = new();
    private List<WorkoutSession> _filtered = new();
    private Dictionary<int, string> _programNames = new();
    private string    _search   = "";
    private DateTime? _dateFrom;
    private DateTime? _dateTo;
    private bool   _loading  = true;
    private string _unit     = "km";
    private string? _importStatus;

    protected override async Task OnInitializedAsync()
    {
        try { _unit = (await Api.GetSettingsAsync())?.DistanceUnit ?? "km"; } catch { }
        try
        {
            var progs = await Api.GetProgramsAsync();
            _programNames = progs?.ToDictionary(p => p.Id, p => p.Name) ?? new();
        }
        catch { }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true; StateHasChanged();
        try
        {
            if (_dateFrom.HasValue && _dateTo.HasValue)
            {
                var start = _dateFrom.Value.ToUniversalTime().ToString("o");
                var end   = _dateTo.Value.AddDays(1).ToUniversalTime().ToString("o");
                _all = (await Api.GetWorkoutsByRangeAsync(start, end)) ?? new();
            }
            else
            {
                _all = (await Api.GetWorkoutsAsync()) ?? new();
            }
            ApplySearch();
        }
        catch (Exception ex) { _importStatus = $"Error loading: {ex.Message}"; }
        finally { _loading = false; }
    }

    private void OnSearchInput(ChangeEventArgs e) { _search = e.Value?.ToString() ?? ""; ApplySearch(); }

    private void ApplySearch()
    {
        _filtered = string.IsNullOrWhiteSpace(_search)
            ? _all.ToList()
            : _all.Where(s => s.SessionDate.ToString("MMM d yyyy").Contains(_search, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private void ClearFilters() { _search = ""; _dateFrom = null; _dateTo = null; _ = LoadAsync(); }

    private void Edit(int id) => Nav.NavigateTo(Nav.BaseUri + $"log?id={id}");

    private async Task Delete(int id)
    {
        try { await Api.DeleteWorkoutAsync(id); await LoadAsync(); }
        catch (Exception ex) { _importStatus = $"Error: {ex.Message}"; }
    }

    private async Task ExportCsv()
    {
        try
        {
            var bytes = await Api.ExportCsvAsync();
            await DownloadFile(bytes, $"treadlog-{DateTime.UtcNow:yyyyMMdd}.csv", "text/csv");
        }
        catch (Exception ex) { _importStatus = $"Export failed: {ex.Message}"; }
    }

    private async Task ExportJson()
    {
        try
        {
            var bytes = await Api.ExportJsonAsync();
            await DownloadFile(bytes, $"treadlog-{DateTime.UtcNow:yyyyMMdd}.json", "application/json");
        }
        catch (Exception ex) { _importStatus = $"Export failed: {ex.Message}"; }
    }

    private async Task ImportFile(InputFileChangeEventArgs e)
    {
        _importStatus = null;
        try
        {
            var file  = e.File;
            var bytes = new byte[file.Size];
            await using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            await stream.ReadExactlyAsync(bytes);

            var result = await Api.ImportFileAsync(bytes, file.Name);
            if (result != null)
            {
                _importStatus = result.Errors.Any()
                    ? $"Imported {result.InsertedRows}/{result.TotalRows} rows. Errors: {string.Join("; ", result.Errors.Take(3))}"
                    : $"Imported {result.InsertedRows} rows ({result.SkippedRows} duplicates skipped).";
                await LoadAsync();
            }
        }
        catch (Exception ex) { _importStatus = $"Import failed: {ex.Message}"; }
    }

    private async Task DownloadFile(byte[] bytes, string name, string mime)
    {
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("eval",
            $"(()=>{{const a=document.createElement('a');a.href='data:{mime};base64,{base64}';a.download='{name}';a.click();}})()");
    }

    private string FormatDist(double km)
        => _unit == "mi"
            ? $"{UnitConverter.KmToMiles(km):F2} mi"
            : $"{km:F2} km";

    private string FormatSpeed(double kmh)
        => _unit == "mi"
            ? $"{UnitConverter.KmhToMph(kmh):F1} mph"
            : $"{kmh:F1} km/h";

    private static string FormatDuration(int s)
        => $"{s / 3600}:{s % 3600 / 60:D2}:{s % 60:D2}";
}
