<UserControl x:Class="TreadLog.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns:vm="clr-namespace:TreadLog.ViewModels"
             xmlns:support="clr-namespace:TreadLog.ViewModels.Support"
             Background="{StaticResource AppBackground}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,28">

            <!-- ── Header ──────────────────────────────────────────────────── -->
            <TextBlock Text="Dashboard"
                       FontSize="26" FontWeight="Bold"
                       Margin="0,0,0,4"/>
            <TextBlock Text="Your training at a glance"
                       FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,0,0,24"/>

            <!-- ── Date filter ──────────────────────────────────────────────── -->
            <Border Background="{StaticResource CardBackground}"
                    CornerRadius="10" Padding="16,14" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Date Range" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Last 7 days" GroupName="Filter"
                                     IsChecked="{Binding SelectedFilter,
                                         Converter={StaticResource EnumToBoolConverter},
                                         ConverterParameter=Last7Days}"/>
                        <RadioButton Content="Last 30 days" GroupName="Filter"
                                     IsChecked="{Binding SelectedFilter,
                                         Converter={StaticResource EnumToBoolConverter},
                                         ConverterParameter=Last30Days}"/>
                        <RadioButton Content="Year to date" GroupName="Filter"
                                     IsChecked="{Binding SelectedFilter,
                                         Converter={StaticResource EnumToBoolConverter},
                                         ConverterParameter=YearToDate}"/>
                        <RadioButton Content="Custom" GroupName="Filter"
                                     IsChecked="{Binding SelectedFilter,
                                         Converter={StaticResource EnumToBoolConverter},
                                         ConverterParameter=Custom}"/>
                    </StackPanel>

                    <!-- Custom date pickers -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                Visibility="{Binding SelectedFilter,
                                    Converter={StaticResource EnumToVisibilityConverter},
                                    ConverterParameter=Custom}">
                        <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <DatePicker Width="140" SelectedDate="{Binding CustomStartDate}" Margin="0,0,16,0"/>
                        <TextBlock Text="To:" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <DatePicker Width="140" SelectedDate="{Binding CustomEndDate}" Margin="0,0,16,0"/>
                        <Button Content="Apply" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding ApplyCustomFilterCommand}" Padding="14,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── KPI cards ────────────────────────────────────────────────── -->
            <UniformGrid Columns="4" Margin="0,0,0,24">
                <!-- Total Distance -->
                <Border Background="{StaticResource CardBackground}"
                        CornerRadius="10" Padding="20,18" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="TOTAL DISTANCE" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding TotalDistanceDisplay}"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Total Time -->
                <Border Background="{StaticResource CardBackground}"
                        CornerRadius="10" Padding="20,18" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="TOTAL TIME" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding TotalTimeDisplay}"
                                   FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- Avg Pace -->
                <Border Background="{StaticResource CardBackground}"
                        CornerRadius="10" Padding="20,18" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="AVG PACE" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding AveragePaceDisplay}"
                                   FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- Sessions -->
                <Border Background="{StaticResource CardBackground}"
                        CornerRadius="10" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="SESSIONS" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding SessionCount}"
                                   FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ── Charts ────────────────────────────────────────────────────── -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Weekly distance bar chart -->
                <Border Grid.Column="0" Background="{StaticResource CardBackground}"
                        CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Weekly Distance" FontSize="14" FontWeight="SemiBold"
                                   Margin="0,0,0,12"/>
                        <oxy:PlotView x:Name="WeeklyPlot" Height="220"
                                      Background="Transparent"/>
                    </StackPanel>
                </Border>

                <!-- Speed + incline trend chart -->
                <Border Grid.Column="2" Background="{StaticResource CardBackground}"
                        CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Speed &amp; Incline Trend" FontSize="14" FontWeight="SemiBold"
                                   Margin="0,0,0,12"/>
                        <oxy:PlotView x:Name="TrendPlot" Height="220"
                                      Background="Transparent"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Loading overlay -->
            <Border Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="#80000000" CornerRadius="8" Padding="16" Margin="0,16,0,0"
                    HorizontalAlignment="Center">
                <TextBlock Text="Loading…" Foreground="White" FontSize="14"/>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
