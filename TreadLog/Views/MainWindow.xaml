<Window x:Class="TreadLog.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TreadLog" Height="760" Width="1280"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Sidebar ──────────────────────────────────────────────────────── -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBackground}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- App title -->
                <StackPanel DockPanel.Dock="Top" Margin="24,28,24,20">
                    <TextBlock Text="TreadLog"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Treadmill Tracker"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <Rectangle DockPanel.Dock="Top"
                           Height="1" Margin="16,0,16,12"
                           Fill="{StaticResource BorderBrush}"/>

                <!-- Nav buttons -->
                <StackPanel DockPanel.Dock="Top">
                    <Button Content="  Dashboard"
                            Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateToDashboardCommand}"/>

                    <Button Content="  Log Workout"
                            Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateToLogWorkoutCommand}"/>

                    <Button Content="  History"
                            Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateToHistoryCommand}"/>

                    <Button Content="  Settings"
                            Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateToSettingsCommand}"/>
                </StackPanel>

                <!-- Version footer -->
                <TextBlock DockPanel.Dock="Bottom"
                           Text="v1.0 alpha"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"/>

                <Grid/>
            </DockPanel>
        </Border>

        <!-- ── Content area ─────────────────────────────────────────────────── -->
        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentViewModel}"
                        Focusable="False"/>
    </Grid>
</Window>
